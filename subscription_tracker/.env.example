# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-string

# Optional PostgreSQL database (leave blank to use local SQLite).
# For Neon, paste the connection string from the Neon dashboard.
DATABASE_URL=

# Set to "true" to run without Gmail/Google login, using sample data instead.
# Great for demos/presentations before OAuth is set up.
DEMO_MODE=true

# Google OAuth (only needed when DEMO_MODE=false)
# Create these at https://console.cloud.google.com/apis/credentials
# 1. Create a project -> Enable "Gmail API"
# 2. Create OAuth client ID (type: Web application)
# 3. Add redirect URI: http://localhost:5000/oauth2callback
# 4. Download the client secret JSON and place it at google_client_secret.json
GOOGLE_CLIENT_SECRET_FILE=google_client_secret.json

# Optional: Gemini API key for smarter email classification + chatbot.
# Get a free key at https://aistudio.google.com/app/apikey
# Leave blank to fall back to keyword-only detection and a rule-based chatbot.
GEMINI_API_KEY=
